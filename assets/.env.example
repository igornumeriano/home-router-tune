# home-router-tune — credentials & toggles
#
# Copy this file to ./router-tune/.env (preferred) and fill in real values.
# The skill never asks for these interactively; it reads them from disk only.
# Keep .env out of git: the skill writes a .gitignore for ./router-tune/
# automatically, but double-check before committing.

# ---- required ---------------------------------------------------------------

# Admin panel address. Common defaults:
#   192.168.0.1  192.168.1.1  192.168.0.254  192.168.100.1  10.0.0.1  fritz.box
ROUTER_HOST=192.168.0.1

# Admin username. Look on the modem label or the ISP welcome letter.
# Many ISPs ship per-device usernames like OPERATOR_<MAC-suffix>.
ROUTER_USER=admin

# Admin password. Some firmwares enforce a factory pattern printed on the
# label; if you've never logged in, try that first. The skill can audit
# whether the current password still matches a known factory pattern.
ROUTER_PASS=replace-me

# ---- optional: vendor hints -------------------------------------------------

# Identifier of a playbook in references/vendors/<vendor>.md.
# Leave blank to auto-detect from the login page. Currently shipped:
#   sagemcom-fast-3895
ROUTER_VENDOR=

# Path to the login form, relative to ROUTER_HOST. Auto-detected if unset.
# Override only when the firmware uses an unusual path
# (e.g. /2.0/gui/login on Sagemcom, /home.html on some TP-Link).
ROUTER_LOGIN_PATH=

# Use HTTPS for the admin panel. Most modern ISP gateways serve HTTPS with
# a self-signed cert; dev-browser will accept it. Set to false only if the
# firmware is HTTP-only and HTTPS returns ECONNREFUSED.
ROUTER_HTTPS=true

# Path to the firmware's config-XML backup endpoint, if it exposes one.
# Used by Phase 1 as the disaster-recovery anchor before any change.
# Leave blank to skip the backup step.
ROUTER_BACKUP_PATH=

# ---- optional: behavioural toggles ------------------------------------------

# Phase 3 prints every action but does NOT click Apply. Use as a rehearsal.
DRY_RUN=false

# Phase 3 skips the human-approval gate IF the current plan exactly matches
# an action set the user approved on a prior run (matched by stable action
# id + target value, found in history.md). Useful for "fix DFS drift" cron
# jobs; leave false for interactive runs.
AUTO_APPROVE=false

# Phase 1 captures speedtest + ping baselines (and Phase 4 reports deltas)
# when the binaries are available. Set false to skip even if installed.
SPEEDTEST=true

# Optional webhook for end-of-run summary. POSTs the JSON shape documented
# in references/output-schemas.md. Examples:
#   Slack:    https://hooks.slack.com/services/T.../B.../...
#   ntfy.sh:  https://ntfy.sh/<your-topic>
#   Pushover: https://api.pushover.net/1/messages.json (needs a wrapper)
# Never includes credentials in the payload.
NOTIFY_WEBHOOK=
